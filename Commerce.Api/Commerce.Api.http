@Host = http://localhost:8003
@BuyerId = 11111111-1111-1111-1111-111111111111
@SkuId1 = 22222222-2222-2222-2222-222222222221
@SkuId2 = 22222222-2222-2222-2222-222222222222

### 1. Health Probe
GET {{Host}}/health
Accept: application/json

### 2. Swagger OpenAPI Specification
GET {{Host}}/swagger/v1/swagger.json
Accept: application/json

### 3. Get My Cart (CART-01)
GET {{Host}}/api/v1/carts/me
X-User-Id: {{BuyerId}}
X-User-Roles: buyer
Accept: application/json

### 4. Get Cart Summary & Badge Count (CART-02)
GET {{Host}}/api/v1/carts/me/summary
X-User-Id: {{BuyerId}}
X-User-Roles: buyer
Accept: application/json

### 5. Get Grouped Cart by Seller (CART-03)
GET {{Host}}/api/v1/carts/me/grouped
X-User-Id: {{BuyerId}}
X-User-Roles: buyer
Accept: application/json

### 6. Add Item to Cart (CART-04)
POST {{Host}}/api/v1/carts/me/items
X-User-Id: {{BuyerId}}
X-User-Roles: buyer
Content-Type: application/json

{
  "skuId": "{{SkuId1}}",
  "quantity": 2
}

### 7. Update Cart Item Quantity (CART-05)
PATCH {{Host}}/api/v1/carts/me/items/00000000-0000-0000-0000-000000000000
X-User-Id: {{BuyerId}}
X-User-Roles: buyer
Content-Type: application/json

{
  "cartItemId": "00000000-0000-0000-0000-000000000000",
  "quantity": 3
}

### 8. Change SKU Variant (CART-06)
PATCH {{Host}}/api/v1/carts/me/items/00000000-0000-0000-0000-000000000000/variant
X-User-Id: {{BuyerId}}
X-User-Roles: buyer
Content-Type: application/json

{
  "newSkuId": "{{SkuId2}}"
}

### 9. Remove Single Item (CART-07)
DELETE {{Host}}/api/v1/carts/me/items/00000000-0000-0000-0000-000000000000
X-User-Id: {{BuyerId}}
X-User-Roles: buyer
Accept: application/json

### 10. Bulk Remove Selected Items (CART-08)
POST {{Host}}/api/v1/carts/me/items:bulk-remove
X-User-Id: {{BuyerId}}
X-User-Roles: buyer
Content-Type: application/json

{
  "cartItemIds": [
    "00000000-0000-0000-0000-000000000000"
  ],
  "clearAll": false
}

### 11. Clear Entire Cart (CART-09)
DELETE {{Host}}/api/v1/carts/me/clear
X-User-Id: {{BuyerId}}
X-User-Roles: buyer
Accept: application/json

### 12. Calculate Selected Items (CART-10)
POST {{Host}}/api/v1/carts/me/calculate
X-User-Id: {{BuyerId}}
X-User-Roles: buyer
Content-Type: application/json

{
  "selectedItemIds": []
}

### 13. Pre-checkout Validation (CART-11)
POST {{Host}}/api/v1/carts/me/validate
X-User-Id: {{BuyerId}}
X-User-Roles: buyer
Content-Type: application/json

{
  "selectedItemIds": []
}

### 14. Merge Guest Cart (CART-12)
POST {{Host}}/api/v1/carts/me/merge
X-User-Id: {{BuyerId}}
X-User-Roles: buyer
Content-Type: application/json

{
  "guestItems": [
    {
      "skuId": "{{SkuId2}}",
      "quantity": 1
    }
  ]
}

### 15. Cleanup Checked Out Items (CART-13)
POST {{Host}}/api/v1/carts/me/cleanup-checked-out
X-User-Id: {{BuyerId}}
X-User-Roles: buyer
Content-Type: application/json

{
  "purchasedCartItemIds": [
    "00000000-0000-0000-0000-000000000000"
  ]
}

### 16. Admin/Staff Get Active Cart by Buyer ID (CART-14)
GET {{Host}}/api/v1/carts/active?buyerId={{BuyerId}}
X-User-Id: {{BuyerId}}
X-User-Roles: admin
Accept: application/json
