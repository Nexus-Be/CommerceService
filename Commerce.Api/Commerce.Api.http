@Host = http://localhost:8003
@BuyerId = 11111111-1111-1111-1111-111111111111
@SkuId1 = 22222222-2222-2222-2222-222222222221
@SkuId2 = 22222222-2222-2222-2222-222222222222

### 1. Health Probe
GET {{Host}}/health
Accept: application/json

### 2. Swagger OpenAPI
GET {{Host}}/swagger/v1/swagger.json
Accept: application/json

### 3. Get My Cart (CART-01)
GET {{Host}}/api/v1/carts/me
X-User-Id: {{BuyerId}}
X-User-Roles: buyer
Accept: application/json

### 4. Add Item to Cart (CART-02)
POST {{Host}}/api/v1/carts/me/items
X-User-Id: {{BuyerId}}
X-User-Roles: buyer
Content-Type: application/json

{
  "skuId": "{{SkuId1}}",
  "quantity": 2
}

### 5. Get Cart Summary & Badge Count (CART-08)
GET {{Host}}/api/v1/carts/me/summary
X-User-Id: {{BuyerId}}
X-User-Roles: buyer
Accept: application/json

### 6. Calculate Selected Items (CART-09)
POST {{Host}}/api/v1/carts/me/calculate
X-User-Id: {{BuyerId}}
X-User-Roles: buyer
Content-Type: application/json

{
  "selectedItemIds": []
}

### 7. Pre-checkout Validation (CART-06)
POST {{Host}}/api/v1/carts/me/validate
X-User-Id: {{BuyerId}}
X-User-Roles: buyer
Content-Type: application/json

{
  "selectedItemIds": []
}

### 8. Merge Guest Cart (CART-10)
POST {{Host}}/api/v1/carts/me/merge
X-User-Id: {{BuyerId}}
X-User-Roles: buyer
Content-Type: application/json

{
  "guestItems": [
    {
      "skuId": "{{SkuId2}}",
      "quantity": 1
    }
  ]
}

### 9. Clear Cart (CART-05)
DELETE {{Host}}/api/v1/carts/me/clear
X-User-Id: {{BuyerId}}
X-User-Roles: buyer
Accept: application/json
