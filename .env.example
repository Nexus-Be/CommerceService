# Environment variables for Commerce Service
ASPNETCORE_ENVIRONMENT=Development
COMMERCE_SERVICE_PORT=8003
COMMERCE_DB_PORT=5435

# Database Connection (Neon Cloud PostgreSQL)
CONNECTION_STRING=Host=ep-fragrant-pond-a1b7qj0e.ap-southeast-1.aws.neon.tech;Port=5432;Database=commerce_db;Username=neondb_owner;Password=<REPLACE_WITH_COMMERCE_DB_PASSWORD>;SSL Mode=Require;Trust Server Certificate=true

# Database (PostgreSQL Local Fallback)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<REPLACE_WITH_DB_PASSWORD>

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=<REPLACE_WITH_RABBITMQ_PASSWORD>

# OpenTelemetry Distributed Tracing
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4317
