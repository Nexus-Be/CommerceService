# =============================================================================
# ENVIRONMENT VARIABLES FOR COMMERCE SERVICE (.env.example)
# =============================================================================
ASPNETCORE_ENVIRONMENT=Development
COMMERCE_SERVICE_PORT=8003

# Database Connection (Local PostgreSQL - Port 5435)
CONNECTION_STRING=Host=localhost;Port=5435;Database=commerce_db;Username=postgres;Password=postgres
COMMERCE_CONNECTION_STRING=Host=localhost;Port=5435;Database=commerce_db;Username=postgres;Password=postgres
COMMERCE_DB_PORT=5435
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# RabbitMQ (Docker network: rabbitmq; Local host: localhost)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# OpenTelemetry Distributed Tracing
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
