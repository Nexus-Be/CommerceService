# =============================================================================
# ENVIRONMENT VARIABLES FOR COMMERCE SERVICE (.env.example)
# =============================================================================
ASPNETCORE_ENVIRONMENT=Development
COMMERCE_SERVICE_PORT=8003

# Database Connection (Neon Cloud PostgreSQL)
CONNECTION_STRING=Host=ep-bold-poetry-b501gcqr-pooler.c-7.us-east-2.aws.neon.tech;Port=5432;Database=commerce_db;Username=neondb_owner;Password=<REPLACE_WITH_COMMERCE_DB_PASSWORD>;SSL Mode=Require;Trust Server Certificate=true
COMMERCE_CONNECTION_STRING=Host=ep-bold-poetry-b501gcqr-pooler.c-7.us-east-2.aws.neon.tech;Port=5432;Database=commerce_db;Username=neondb_owner;Password=<REPLACE_WITH_COMMERCE_DB_PASSWORD>;SSL Mode=Require;Trust Server Certificate=true

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=<REPLACE_WITH_RABBITMQ_PASSWORD>

# OpenTelemetry Distributed Tracing
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4317
