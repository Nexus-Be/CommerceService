# =============================================================================
# NEXUS COMMERCE SERVICE - ENVIRONMENT (.env.local.example)
# =============================================================================
# DB local (cụm src/Infrastructure/databases). Hạ tầng dùng chung nexus-network.

ASPNETCORE_ENVIRONMENT=Development
COMMERCE_SERVICE_PORT=8003

# Database (Neon Cloud PostgreSQL)
COMMERCE_DB_CONNECTION=Host=localhost;Port=5435;Database=commerce_db;Username=postgres;Password=postgres

# Downstream service URLs
WALLET_SERVICE_URL=http://localhost:8008
CATALOG_SERVICE_URL=http://localhost:8002

# Internal service-to-service authentication
INTERNAL_SERVICE_SECRET=eaT0Ombups70WJzd85CBBpp8rAno55SxKn1qvYBGH9e

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
